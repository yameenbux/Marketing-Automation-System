      {"id": "corporate", "label": "Corporate subscriber (CIO / charitable company) — needed for email", "weight": 15, "field": "subscriber_type", "equals": "corporate"},
      {"id": "has_website", "label": "Has its own website", "weight": 15, "field": "website", "present": true}
    ],
    "exclude": [{"field": "signals", "contains": "existing_customer"}]
  },
  "domi": {
    "derived_from_facts": ["audience-*"],
