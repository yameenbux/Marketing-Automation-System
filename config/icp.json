      {"id": "corporate", "label": "Limited company", "weight": 20, "field": "subscriber_type", "equals": "corporate"},
      {"id": "has_website", "label": "Has its own website", "weight": 10, "field": "website", "present": true},
      {"id": "multi_clinician", "label": "More than one clinician (routing matters)", "weight": 10, "field": "signals", "contains": "multi_clinician"}
    ],
    "exclude": []
