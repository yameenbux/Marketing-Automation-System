# Copy to .env (never commit .env). Every value here is OPTIONAL — the system runs in
# dry-run with none of them set.

# Emergency stop. Any of: 1/true/yes halts every side-effecting action.
MAS_KILL_SWITCH=0

# Optional: raises GitHub's unauthenticated limit (60 req/h) to 5000 req/h.
# Use a fine-grained token with *public repositories read-only* and nothing else.
GITHUB_TOKEN=

# Optional: Anthropic API for LLM copywriting. NOT included in a Claude subscription — billed separately.
ANTHROPIC_API_KEY=

# Optional: Companies House public data API (free key from developer.company-information.service.gov.uk)
COMPANIES_HOUSE_API_KEY=
